# Скопируйте этот файл в .env (или экспортируйте переменные в шелле) и заполните значения.

# Ключ DeepSeek API (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Необязательно: путь к папке с распакованной моделью Vosk,
# если не хотите класть её в ./models/vosk-model-small-ru-0.22
# VOSK_MODEL_PATH=/path/to/vosk-model-small-ru-0.22

# Необязательно: имя голоса `say` для озвучки (по умолчанию Milena)
# EDUARDO_TTS_VOICE=Milena
